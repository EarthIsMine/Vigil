{
  "name": "vigil",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "dev": "pnpm --filter vigil-frontend dev",
    "dev:backend": "pnpm --filter backend dev",
    "dev:all": "pnpm --filter vigil-frontend dev & pnpm --filter backend dev",
    "build": "pnpm --filter vigil-frontend build",
    "build:backend": "pnpm --filter backend build",
    "start": "pnpm --filter vigil-frontend start",
    "lint": "pnpm --filter vigil-frontend lint",
    "lint:backend": "pnpm --filter backend lint"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  }
}
